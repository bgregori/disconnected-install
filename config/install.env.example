# disconnected-install configuration
#
# Copy to config/install.env and edit. Every script in scripts/ sources
# this file.
#
# It records credentials-adjacent facts -- the IdP client ID, the issuer,
# paths to secret material -- so the copy you create should be moded
# accordingly:
#
#   cp config/install.env.example config/install.env
#   chmod 600 config/install.env
#   ${EDITOR} config/install.env
#
# The IdP CLIENT SECRET is deliberately NOT a variable here. It is passed
# from stdin or a file at the moment it is used, so that it reaches
# neither this file nor /proc/<pid>/cmdline. See docs/07-identity.md.

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

# Root of the install tree: the handoff bundle, the install directory, the
# agent ISO and the evidence pack all live under it.
#
# On a STIG build /home is its own file system, sized for user files and
# often quota'd. Put this on the volume you provisioned for it:
#   OCP_INSTALL_ROOT="/data/ocp-install"
#
# An exported OCP_INSTALL_ROOT wins, so the value the docs have you export
# by hand and the value the scripts use are the same variable.
OCP_INSTALL_ROOT="${OCP_INSTALL_ROOT:-${HOME}/ocp-install}"

# The install directory -- what every --dir argument points at. The
# installer destroys and regenerates its contents, so nothing you want to
# keep may live here. See docs/02-install-config.md.
INSTALL_DIR="${OCP_INSTALL_ROOT}/cluster"

# Where prep's handoff bundle was unpacked.
HANDOFF_DIR="${OCP_INSTALL_ROOT}/handoff"

# MachineConfigs and manifests staged into the window between `create
# manifests` and `create ignition-configs`. Kept OUTSIDE the install
# directory deliberately -- a re-run wipes that directory, and editing
# manifests in place and re-running is how a node boots unencrypted.
# See docs/03-manifests.md.
MANIFESTS_SRC="${OCP_INSTALL_ROOT}/manifests-src"

# Scan results, remediation records and the evidence pack.
# See docs/12-evidence-pack.md.
EVIDENCE_DIR="${OCP_INSTALL_ROOT}/evidence"

# ---------------------------------------------------------------------------
# Cluster identity
# ---------------------------------------------------------------------------

# These are baked into every certificate the cluster issues. Changing
# either after install means a reinstall.
CLUSTER_NAME="ocp1"
BASE_DOMAIN="airgap.local"

# single-node | compact | multi-node
# Replica counts are install-time. See docs/topologies/.
TOPOLOGY="compact"

# Exact z-stream prep mirrored. It must match the ImageSetConfiguration in
# the handoff bundle -- nothing else is published in the registry, and a
# mismatch presents as "manifest unknown" rather than as a wrong version.
OCP_VERSION="4.21.34"

# Cluster architecture, Go-style, as install-config.yaml spells it.
OCP_ARCH="amd64"

# The same architecture as named in release image TAGS, which uses the
# GNU-style name. These differ and the mismatch is a common source of
# "manifest unknown":
#   amd64 -> x86_64     arm64 -> aarch64
RELEASE_ARCH="x86_64"

# ---------------------------------------------------------------------------
# Mirror registry (prep's -- this repository never writes to it)
# ---------------------------------------------------------------------------

# Must resolve from the CLUSTER NODES, not just from the install host, and
# must match the subjectAltName on prep's registry certificate and the
# key in the mirror pull secret, port included.
REGISTRY_HOST="registry.airgap.local"
REGISTRY_PORT="8443"

# From the handoff bundle. This is the MIRROR pull secret, not a Red Hat
# one -- prep deliberately does not carry a Red Hat pull secret across the
# airgap and the cluster has nothing to use one for.
MIRROR_PULL_SECRET="${HANDOFF_DIR}/pull-secret.json"

# Registry CA, from the handoff bundle. Becomes additionalTrustBundle.
REGISTRY_CA="${HANDOFF_DIR}/certs/rootCA.pem"

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------

# Unused addresses on the machine network. Verified NOT to answer before
# install -- see docs/01-intake.md. On single node the VIP story differs;
# see docs/topologies/sno.md.
API_VIP=""
INGRESS_VIP=""

# NTP reachable from the NODE network. Not optional: certificate
# validation fails on skew and the failure presents as TLS errors that do
# not mention time. The default configuration points at a public pool,
# which is unreachable here. Configured as a MachineConfig before
# ignition -- docs/03-manifests.md.
NTP_SERVERS=""

# Tang servers for NBDE, if that is the disk encryption mode. These are a
# cluster dependency with the same standing as the mirror registry: if
# they go away, nodes do not boot. Leave empty for TPM v2 or for no
# encryption. See docs/03-manifests.md.
TANG_SERVERS=""

# ---------------------------------------------------------------------------
# Identity (external Red Hat build of Keycloak)
# ---------------------------------------------------------------------------
#
# The IdP runs OUTSIDE the cluster, on a services host. Nothing
# identity-related needs mirroring. See docs/07-identity.md.

# The realm's issuer URL. This is OUTBOUND traffic from an airgapped
# cluster -- a firewall path that is routinely missed because identity is
# agreed before networking is.
IDP_ISSUER_URL=""

# Created on the IdP for this cluster specifically. One per cluster.
IDP_CLIENT_ID=""

# CA that signed the IdP's serving certificate. Required even when the
# IdP's certificate chains to a CA the rest of the estate trusts -- the
# cluster does not inherit the estate's trust store. Record its EXPIRY
# DATE somewhere with a calendar attached: when it passes, nobody can log
# in, without warning.
IDP_CA_FILE=""

# The group, as it appears in the IdP's `groups` claim, that is bound to
# cluster-admin. A GROUP, not a user -- a user binding has to be
# maintained by hand as people join and leave, which means it will not be.
# It must exist and be populated BEFORE kubeadmin is deleted.
CLUSTER_ADMIN_GROUP=""

# ---------------------------------------------------------------------------
# Compliance
# ---------------------------------------------------------------------------

# Both are needed. They check different things, and a clean ocp4-stig says
# nothing about the nodes. See docs/09-compliance-operator.md.
COMPLIANCE_PROFILES="ocp4-stig rhcos4-stig"

# Namespace the Compliance Operator is installed into.
COMPLIANCE_NAMESPACE="openshift-compliance"

# ---------------------------------------------------------------------------
# Tunables
# ---------------------------------------------------------------------------

# Minimum free space, in GB, under OCP_INSTALL_ROOT. A floor that catches
# an undersized host, not a recommendation. The tree holds the handoff
# bundle, the install directory and at least one agent ISO.
MIN_INSTALL_GB="50"
